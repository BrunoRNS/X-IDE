HTTP_PORT=8080
HTTPS_PORT=8443
MYSQL_PORT=3306
DB_NAME=xide
DB_USER=xide
DB_PASSWORD=change-this-password
DB_ROOT_PASSWORD=change-this-root-password
BIND_ADDRESS=0.0.0.0
# Plain HTTP ports used by the Class page to host folders for students.
CLASSROOM_PORT_RANGE=8083-8102
# TLS_HOST is optional: auto-detected from the LAN IP when unset. Set it only to
# pin a fixed address for the TLS certificate.